# =========================================================================
#  Reasonix Bridge — 环境变量配置
#  复制此文件为 .env 并填入你的 Key
#  .env 已被 .gitignore 排除，不会提交到 GitHub
# =========================================================================

# ──── 必填 ────
DEEPSEEK_API_KEY=sk-your-key-here

# ──── 推荐 ────
REASONIX_COMMAND_MODE=static

# ──── 可选 ────
# WORKSPACE_ROOT=F:\your-project
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TEMPERATURE=0.2
# REASONIX_MAX_TOKENS=64000
# REASONIX_AGENT_MAX_TURNS=10
# REASONIX_CALL_MAX_TOKENS=8000
# HTTP_PROXY=http://127.0.0.1:7890
# GITHUB_TOKEN=ghp_your_github_token
